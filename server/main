-- Kirim jumlah pemain, slot maksimal, dan ping ke tiap pemain
CreateThread(function()
    local max = GetConvarInt('sv_maxclients', 48)
    while true do
        local players = GetPlayers()
        local count = #players
        for i = 1, count do
            local src = tonumber(players[i])
            TriggerClientEvent('minihud:serverInfo', src, count, max, GetPlayerPing(src))
        end
        Wait(5000)
    end
end)

-- ---------- stres (ditulis ke metadata.stress pemain) ----------
local function framework()
    if Config.Framework ~= 'auto' then return Config.Framework end
    if GetResourceState('qbx_core') ~= 'missing' then return 'qbox' end
    if GetResourceState('qb-core') ~= 'missing' then return 'qb' end
    return 'standalone'
end

local function getPlayer(src)
    local fw = framework()
    if fw == 'qbox' then return exports.qbx_core:GetPlayer(src) end
    if fw == 'qb' then return exports['qb-core']:GetCoreObject().Functions.GetPlayer(src) end
end

local lastChange = {}

local function changeStress(src, delta)
    if not (Config.Stress and Config.Stress.enabled) then return end
    local now = GetGameTimer()
    if lastChange[src] and now - lastChange[src] < 400 then return end -- anti-spam
    lastChange[src] = now

    local player = getPlayer(src)
    if not player then return end
    local meta = player.PlayerData.metadata or {}
    local cur = meta.stress or 0
    local new = math.max(0, math.min(100, cur + delta))
    if new == cur then return end
    player.Functions.SetMetaData('stress', new)
end

local function clampAmount(v)
    return math.min(math.max(math.floor(tonumber(v) or 0), 0), 5)
end

RegisterNetEvent('minihud:server:gainStress', function(amount)
    changeStress(source, clampAmount(amount))
end)

RegisterNetEvent('minihud:server:relieveStress', function(amount)
    changeStress(source, -clampAmount(amount))
end)

-- kompatibel dengan script yang memanggil event gaya qb-hud (matikan lewat Config.Stress.compat = false)
if Config.Stress and Config.Stress.compat then
    RegisterNetEvent('hud:server:GainStress', function(amount) changeStress(source, clampAmount(amount)) end)
    RegisterNetEvent('hud:server:RelieveStress', function(amount) changeStress(source, -clampAmount(amount)) end)
end

AddEventHandler('playerDropped', function() lastChange[source] = nil end)
